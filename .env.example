# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_db?schema=public"

# Auth
JWT_SECRET="super-secret-jwt-key"
JWT_REFRESH_SECRET="super-secret-refresh-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Ports & URLs
PORT=3000
VITE_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Payment Services
PAYMENT_STRIPE_SECRET_KEY="sk_test_xxx"
PAYMENT_STRIPE_WEBHOOK_SECRET="whsec_xxx"

# SMTP Mail Server
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
SMTP_FROM="noreply@hotel-platform.com"

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID="hotel-platform-fcm"
FCM_CLIENT_EMAIL="fcm-adminsdk@hotel-platform.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
